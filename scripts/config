#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#REMOVEME? ynh_abort_if_errors

# import needed settings
php_version=$(ynh_app_setting_get --key=php_version)
upload_max_filesize=$(ynh_app_setting_get --key=upload_max_filesize)
post_max_size=$(ynh_app_setting_get --key=post_max_size)

#=================================================
# SPECIFIC GETTERS
#=================================================

# because __PHP_VERSION__ is not hydrated in a config panel bind :/

get__upload_max_filesize() {
    ynh_read_var_in_file --file="/etc/php/$php_version/fpm/pool.d/$app.conf" --key=upload_max_filesize
}

get__post_max_size() {
    ynh_read_var_in_file --file="/etc/php/$php_version/fpm/pool.d/$app.conf" --key=post_max_size
}

get__wopi_url() {
    local get_wopi_url
    get_wopi_url=$(ynh_read_var_in_file --file="$install_dir/config.local.php" --key=WOPI_DISCOVERY_URL)
    if [[ $get_wopi_url == "null" ]]; then
        echo ""
    else
        echo "$get_wopi_url"
    fi
}

#=================================================
# SPECIFIC SETTERS
#=================================================

set__upload_max_filesize() {

    # update php config
    ynh_config_add_phpfpm

    # save updated setting
    ynh_app_setting_set --key=upload_max_filesize --value="$upload_max_filesize"

}

set__post_max_size() {

    # update php config
    ynh_config_add_phpfpm

    # update nginx config
    ynh_replace --match="client_max_body_size .*;" --replace="client_max_body_size $post_max_size;" --file="/etc/nginx/conf.d/$domain.d/$app.conf"
    ynh_store_file_checksum "/etc/nginx/conf.d/$domain.d/$app.conf"

    # save updated setting
    ynh_app_setting_set --key=post_max_size --value="$post_max_size"

}

set__wopi_url() {

    # the variable must be 'null' if the setting is not used
    if [[ $wopi_url == "" ]]; then
        wopi_url="null"
    fi

    # update karadav config
    ynh_write_var_in_file --file="$install_dir/config.local.php" --key=WOPI_DISCOVERY_URL --value="$wopi_url"
    ynh_store_file_checksum "$install_dir/config.local.php"

    # save updated setting
    ynh_app_setting_set --key=wopi_url --value="$wopi_url"

}

# Keep this last line
ynh_app_config_run "$1"