#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

ynh_config_change_url_nginx

#=================================================
# SPECIFIC MODIFICATIONS
#=================================================
ynh_script_progression "Updating KaraDAV configuration..."

# using 'ynh_replace' because 'ynh_write_var_in_file' doesn't work
ynh_replace --match="const WWW_URL = 'https://.*/';" --replace="const WWW_URL = 'https://$domain$path/';" --file="$install_dir/config.local.php"
ynh_store_file_checksum "$install_dir/config.local.php"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
